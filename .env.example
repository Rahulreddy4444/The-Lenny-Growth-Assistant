# =============================================================================
# The Lenny Growth Assistant — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# =============================================================================

# --- LLM Provider -----------------------------------------------------------
# Which LLM provider to use for chat completions.
# Options: "anthropic" | "ollama"
# Default: "ollama"
LLM_PROVIDER=ollama

# --- Anthropic (required if LLM_PROVIDER=anthropic) -------------------------
# Your Anthropic API key. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Claude model to use (default: claude-sonnet-4-20250514)
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Ollama (required if LLM_PROVIDER=ollama) --------------------------------
# Base URL for Ollama API
# Use http://localhost:11434 for local, http://ollama:11434 for Docker
OLLAMA_BASE_URL=http://localhost:11434

# Ollama chat model (default: llama3.1:8b)
OLLAMA_CHAT_MODEL=llama3.1:8b

# Ollama embedding model (default: nomic-embed-text)
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Database ----------------------------------------------------------------
# PostgreSQL connection string with pgvector extension
# For Docker Compose: postgresql+asyncpg://postgres:postgres@postgres:5432/lenny
# For local: postgresql+asyncpg://postgres:postgres@localhost:5432/lenny
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lenny

# Sync version (used by ingestion script)
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/lenny

# PostgreSQL credentials (used by Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lenny

# --- Backend -----------------------------------------------------------------
# Backend server host and port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Frontend ----------------------------------------------------------------
# Backend API URL as seen from the frontend
# For Docker Compose: http://backend:8000
# For local: http://localhost:8000
BACKEND_URL=http://localhost:8000

# --- Retrieval ---------------------------------------------------------------
# Number of chunks to retrieve for each query
RETRIEVAL_TOP_K=5

# --- Logging -----------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
